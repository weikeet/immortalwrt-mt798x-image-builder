# =========================================================
# MeekuWrt 25.12 通用基础配置 (APK + eBPF/Honk + 基础组件)
# =========================================================

# 包管理与全局构建设置（CI 复用预编译工具链缓存，不启用 ccache）
CONFIG_USE_APK=y
# CONFIG_CCACHE is not set
CONFIG_INCLUDE_CONFIG=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
CONFIG_BPF_TOOLCHAIN_HOST=y

# 禁用 Ruby YJIT，避免 OpenClash 编译时拉起 rust/host
# CONFIG_RUBY_ENABLE_YJIT is not set

# 关闭全局中文语言开关，由配置生成脚本按白名单放行已安装插件的语言包
# CONFIG_LUCI_LANG_zh_Hans is not set

# =========================================================
# Honk (eBPF 透明代理) 内核 BTF / cgroup v2 支持
# =========================================================
CONFIG_KERNEL_BPF=y
CONFIG_KERNEL_BPF_SYSCALL=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_BPF_JIT=y
CONFIG_KERNEL_BPF_JIT_ALWAYS_ON=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_CGROUP_CPUACCT=y
CONFIG_KERNEL_CGROUP_PIDS=y
CONFIG_KERNEL_MEMCG=y
CONFIG_KERNEL_NET_NS=y
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_HONK_USE_KERNEL_BTF=y

# Honk 软件包与运行时内核模块
CONFIG_PACKAGE_honk=y
CONFIG_PACKAGE_luci-app-honk=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# =========================================================
# 共用 LuCI 与基础实用组件
# =========================================================
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y

# =========================================================
# 明确禁用不需要的主题与插件
# =========================================================
# CONFIG_PACKAGE_luci-theme-bootstrap is not set
# CONFIG_PACKAGE_luci-theme-bootstrap-mod is not set
# CONFIG_PACKAGE_luci-app-eqos-mtk is not set
# CONFIG_PACKAGE_luci-app-fm350 is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_samba4-server is not set
# CONFIG_PACKAGE_autosamba is not set
# CONFIG_PACKAGE_luci-app-ksmbd is not set
# CONFIG_PACKAGE_ksmbd-server is not set
# CONFIG_PACKAGE_autoksmbd is not set
# CONFIG_PACKAGE_kmod-fs-ksmbd is not set
# CONFIG_PACKAGE_nano is not set
# CONFIG_PACKAGE_tcpdump is not set
# CONFIG_PACKAGE_htop is not set

# =========================================================
# 磊科 N60 Pro 硬改版 (MT7986A / 2GB RAM / 512MB SPI-NAND)
# 适配无 NMBM U-Boot 布局 (506.5MB 全量 UBI / .itb)
# =========================================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_netcore_n60-pro-512m=y

CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS_SEPARATE=y

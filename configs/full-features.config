# =========================================================
# 高容量设备全功能扩展 (RAX3000M eMMC / N60 Pro 512M / CLX-S20P)
# =========================================================

# OpenClash (内置 Mihomo 核心，使用 Firewall4 / nftables + dnsmasq-full)
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_LUCI_APP_OPENCLASH_INCLUDE_CORE=y

# Tailscale
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale-community=y

# Bandix 流量监控
CONFIG_PACKAGE_bandix=y
CONFIG_PACKAGE_luci-app-bandix=y

# Lucky 网络工具
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y
